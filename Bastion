            spellName: "🌠 Étoiles Filantes (+25 🪙 & +15 Déf)",
            desc: "Clarté nocturne : illumine tes objectifs de fond et soutient tes troupes.",
            cast: (s) => { s.savoir += 25; s.tempDef += 15; return "Étoiles Filantes : +25 Or & Savoir et +15 Défense !"; }
          }
        }
      },

      undead: {
        name: "Fléau de Lordaeron",
        themeClass: "theme-undead",
        workerName: "Acolytes & Goules",
        altarName: "💀 Autel des Ténèbres — Ton Héros",
        motto: "Nous obéissons au Roi-Liche",
        specialBtn: "❄️ Rituel de Terre Maudite",
        specialLog: "❄️ TERRE MAUDITE SCELLÉE ! Les Ziggourats deviennent des Tours des Esprits : +15 Défense immédiate et +10 ressources par tâche aujourd'hui !",
        tiers: [
          { name: "Nécropole", costWood: 0, costGold: 0, baseDef: 15 },
          { name: "Salle des Morts", costWood: 60, costGold: 60, baseDef: 40 },
          { name: "Citadelle Noire", costWood: 120, costGold: 120, baseDef: 80 }
        ],
        buildings: {
          remparts: { name: "🔮 Ziggourat & Tour Nérubienne", res: "materiaux", icon: "🪵", cost: 30, def: 17 },
          caserne:  { name: "🕸️ Crypte (Goules & Démons des Cryptes)", res: "vivres", icon: "🍖", cost: 30, def: 15 },
          academie: { name: "🕯️ Temple des Damnés (Nécromanciens)", res: "savoir", icon: "🪙", cost: 30, def: 18 }
        },
        heroes: {
          deathKnight: {
            label: "🗡️ Chevalier de la Mort (Cadence Implaccable)",
            name: "Chevalier de la Mort",
            spellName: "💀 Voile Mortel (+20 Déf & +15 🍖)",
            desc: "Aura Impie : te permet d'avancer à un rythme soutenu sans faiblir.",
            cast: (s) => { s.tempDef += 20; s.vivres += 15; return "Voile Mortel : +20 Défense et +15 Ravitaillement régénéré !"; }
          },
          lich: {
            label: "❄️ Liche (Maîtrise Académique & Froideur)",
            name: "Liche",
            spellName: "🧊 Nova de Glace (+25 🪙 & +15 Déf)",
            desc: "Savoir interdit : fige les distractions et maximise ta progression.",
            cast: (s) => { s.savoir += 25; s.tempDef += 15; return "Nova de Glace : +25 Or & Savoir et +15 Défense glaciale !"; }
          },
          dreadlord: {
            label: "🦇 Seigneur de l'Effroi (Vampirisme & Nuit)",
            name: "Seigneur de l'Effroi",
            spellName: "🦇 Essaim Carrion (+35 Défense)",
            desc: "Aura Vampirique : chaque effort nourrit directement ta résistance.",
            cast: (s) => { s.tempDef += 35; return "Essaim Carrion lancé : +35 Défense contre l'assaut de la semaine !"; }
          }
        }
      }
    };

    const LOOT_TABLE = [
      { name: "Gants de Hâte", def: 8 },
      { name: "Anneau de Protection", def: 10 },
      { name: "Bottes de Vitesse", def: 10 },
      { name: "Tome de Force", def: 12 },
      { name: "Tome d'Intelligence", def: 12 },
      { name: "Médaillon de Courage", def: 15 },
      { name: "Orbe de Givre", def: 18 },
      { name: "Couronne des Rois", def: 25 }
    ];

    const todayStr = new Date().toISOString().split('T')[0];

    const defaultState = {
      faction: "alliance",
      tierIndex: 0,
      week: 1,
      vivres: 20,
      materiaux: 20,
      savoir: 20,
      tempDef: 0,
      militiaUsedThisWeek: false,
      militiaActiveToday: false,
      truceMode: false,
      reconstructionBoost: false,
      lastDate: todayStr,
      hero: {
        type: "paladin",
        level: 1,
        xp: 0,
        spellUsedToday: false,
        inventory: []
      },
      buildings: { remparts: 1, caserne: 1, academie: 1 },
      dailies: [
        { id: 1, title: "Dormir 7h30+ & cuisiner un vrai repas", cat: "vivres", done: false },
        { id: 2, title: "Vaisselle + 15 min de rangement bureau", cat: "materiaux", done: false },
        { id: 3, title: "Session focus cours / code / projet (45 min)", cat: "savoir", done: false },
        { id: 4, title: "Sport ou marche rapide en extérieur", cat: "vivres", done: false }
      ],
      creeps: [
        { id: 101, title: "Trier mes mails et régler un papier administratif", diff: "green" },
        { id: 102, title: "Boucler un livrable / projet important de la semaine", diff: "orange" }
      ]
    };

    let state = JSON.parse(localStorage.getItem("bastion_wc3_v2")) || defaultState;

    // VÉRIFICATION AUTOMATIQUE DU PASSAGE DES JOURS
    if (state.lastDate && state.lastDate !== todayStr) {
      state.dailies.forEach(t => t.done = false);
      state.hero.spellUsedToday = false;
      state.militiaActiveToday = false;
      state.lastDate = todayStr;
      log("🌅 Un nouveau jour s'est levé ! Les tâches quotidiennes ont été réinitialisées automatiquement.");
    } else if (!state.lastDate) {
      state.lastDate = todayStr;
    }

    // Sécurité si la sauvegarde vient d'une version précédente
    if (!FACTIONS[state.faction]) state.faction = "alliance";
    if (!FACTIONS[state.faction].heroes[state.hero.type]) {
      state.hero.type = Object.keys(FACTIONS[state.faction].heroes)[0];
    }

    function save() {
      localStorage.setItem("bastion_wc3_v2", JSON.stringify(state));
      render();
    }

    function log(msg) {
      const box = document.getElementById("journal");
      if (!box) return;
      const div = document.createElement("div");
      div.style.marginBottom = "5px";
      div.textContent = "• " + msg;
      box.prepend(div);
    }

    // RÉINITIALISATION COMPLÈTE (RESET)
    function resetGame() {
      if (confirm("⚠️ Veux-tu vraiment effacer toute ta progression pour recommencer au Tiers 1 ? (Toutes les factions et races restent disponibles, mais tes ressources, ton niveau et ton Héros seront réinitialisés).")) {
        localStorage.removeItem("bastion_wc3_v2");
        location.reload();
      }
    }

    // CHANGEMENT DE FACTION EN DIRECT
    function changeFaction(newFaction) {
      if (!FACTIONS[newFaction]) return;
      state.faction = newFaction;
      const firstHeroKey = Object.keys(FACTIONS[newFaction].heroes)[0];
      state.hero.type = firstHeroKey;
      log(`Changement d'allégeance : tu diriges désormais la faction ${FACTIONS[newFaction].name} !`);
      save();
    }

    // CALCUL DE L'ENTRETIEN (UPKEEP)
    function getUpkeepMultiplier() {
      const count = state.dailies.length;
      if (count <= 4) return { mult: 1, label: "Aucun (100%)", color: "#4ade80", sub: `${count}/4 habitudes (Optimal)` };
      if (count <= 6) return { mult: 0.8, label: "Faible (80%)", color: "#facc15", sub: `${count} habitudes (Attention à la surcharge)` };
      return { mult: 0.5, label: "Élevé (50%)", color: "#f87171", sub: `${count} habitudes (Trop de tâches ! Déplace en Creeps)` };
    }

    // CALCUL DE LA DÉFENSE TOTALE
    function getTotalDefense() {
      const f = FACTIONS[state.faction];
      const tierDef = f.tiers[state.tierIndex].baseDef;
      const bDef = (state.buildings.remparts * f.buildings.remparts.def)
                 + (state.buildings.caserne * f.buildings.caserne.def)
                 + (state.buildings.academie * f.buildings.academie.def);
      const heroDef = state.hero.level * 10;
      const itemDef = state.hero.inventory.reduce((sum, item) => sum + item.def, 0);
      return tierDef + bDef + heroDef + itemDef + state.tempDef;
    }

    function getThreat() {
      return 65 + (state.week * 30);
    }

    // ACTIONS QUOTIDIENNES
    function completeDaily(id) {
      if (state.truceMode) return log("Mode Trêve actif : quitte la trêve pour valider des tâches.");
      const task = state.dailies.find(t => t.id === id);
      if (!task || task.done) return;

      const f = FACTIONS[state.faction];
      task.done = true;
      const upkeep = getUpkeepMultiplier().mult;
      let baseGain = state.reconstructionBoost ? 30 : 15;
      if (state.militiaActiveToday) baseGain += 10;
      const finalGain = Math.round(baseGain * upkeep);

      state[task.cat] += finalGain;
      if (state.militiaActiveToday) state.tempDef += 5;

      log(`${f.workerName} au travail : "${task.title}" (+${finalGain} ${task.cat}${state.militiaActiveToday ? " & +5 Déf" : ""}).`);
      save();
    }

    function addDaily() {
      const input = document.getElementById("daily-title");
      const cat = document.getElementById("daily-cat").value;
      const title = input.value.trim();
      if (!title) return;
      state.dailies.push({ id: Date.now(), title, cat, done: false });
      input.value = "";
      log(`Nouvelle habitude assignée : "${title}".`);
      save();
    }

    function deleteDaily(id) {
      state.dailies = state.dailies.filter(t => t.id !== id);
      save();
    }

    // CREEPING (TÂCHES PONCTUELLES)
    function addCreep() {
      const input = document.getElementById("creep-title");
      const diff = document.getElementById("creep-diff").value;
      const title = input.value.trim();
      if (!title) return;
      state.creeps.push({ id: Date.now(), title, diff });
      input.value = "";
      log(`Nouveau camp de Creeps repéré sur la carte : "${title}".`);
      save();
    }

    function deleteCreep(id) {
      state.creeps = state.creeps.filter(c => c.id !== id);
      save();
    }

    function clearCreep(id) {
      if (state.truceMode) return;
      const idx = state.creeps.findIndex(c => c.id === id);
      if (idx === -1) return;
      const creep = state.creeps[idx];

      const rewards = {
        green:  { xp: 35, gold: 15, dropChance: 0.35 },
        orange: { xp: 70, gold: 30, dropChance: 0.65 },
        red:    { xp: 120, gold: 60, dropChance: 1.0 }
      }[creep.diff];

      state.savoir += rewards.gold;
      gainHeroXp(rewards.xp);

      let dropMsg = "";
      if (Math.random() <= rewards.dropChance) {
        const item = LOOT_TABLE[Math.floor(Math.random() * LOOT_TABLE.length)];
        if (state.hero.inventory.length < 6) {
          state.hero.inventory.push(item);
          dropMsg = ` 🎁 Objet trouvé : ${item.name} (+${item.def} Déf) !`;
        } else {
          state.savoir += 15;
          dropMsg = ` (Inventaire plein : butin revendu +15 🪙)`;
        }
      }

      state.creeps.splice(idx, 1);
      log(`Camp nettoyé : "${creep.title}" (+${rewards.xp} XP, +${rewards.gold} 🪙).${dropMsg}`);
      save();
    }

    function gainHeroXp(amount) {
      if (state.hero.level >= 10) return;
      state.hero.xp += amount;
      const needed = state.hero.level * 100;
      if (state.hero.xp >= needed) {
        state.hero.xp -= needed;
        state.hero.level = Math.min(10, state.hero.level + 1);
        log(`🎉 LEVEL UP ! Ton Héros atteint le Niveau ${state.hero.level} (+10 Défense permanente) !`);
      }
    }

    // HÉROS & CAPACITÉS SPÉCIALES
    function changeHero() {
      const val = document.getElementById("hero-select").value;
      state.hero.type = val;
      log(`Tu as invoqué le ${FACTIONS[state.faction].heroes[val].name}.`);
      save();
    }

    function castHeroSpell() {
      if (state.truceMode || state.hero.spellUsedToday) return;
      const heroData = FACTIONS[state.faction].heroes[state.hero.type];
      const msg = heroData.cast(state);
      state.hero.spellUsedToday = true;
      log(`👑 Sort de Héros — ${msg}`);
      save();
    }

    function activateMilitia() {
      if (state.truceMode || state.militiaUsedThisWeek) return;
      const f = FACTIONS[state.faction];
      state.militiaUsedThisWeek = true;
      state.militiaActiveToday = true;
      state.tempDef += 15;
      log(f.specialLog);
      save();
    }

    // BÂTIMENTS & TIERS
    function upgradeBuilding(key) {
      if (state.truceMode) return;
      const b = FACTIONS[state.faction].buildings[key];
      if (state[b.res] < b.cost) return log(`Ressources insuffisantes (${b.cost} ${b.icon} requis).`);
      state[b.res] -= b.cost;
      state.buildings[key]++;
      log(`Bâtiment amélioré : ${b.name} passe au niveau ${state.buildings[key]} !`);
      save();
    }

    function upgradeTier() {
      if (state.truceMode || state.tierIndex >= 2) return;
      const nextTier = FACTIONS[state.faction].tiers[state.tierIndex + 1];
      if (state.materiaux < nextTier.costWood || state.savoir < nextTier.costGold) {
        return log(`Il te faut ${nextTier.costWood} 🪵 et ${nextTier.costGold} 🪙 pour passer au ${nextTier.name}.`);
      }
      state.materiaux -= nextTier.costWood;
      state.savoir -= nextTier.costGold;
      state.tierIndex++;
      log(`🏰 ÉVOLUTION MAJEURE : Ton bastion devient un ${nextTier.name} !`);
      save();
    }

    // CYCLE & SIÈGE
    function newDay() {
      state.dailies.forEach(t => t.done = false);
      state.hero.spellUsedToday = false;
      state.militiaActiveToday = false;
      state.lastDate = new Date().toISOString().split('T')[0];
      log("🌅 Une nouvelle journée commence. Tâches quotidiennes et sort du Héros réinitialisés.");
      save();
    }

    function toggleTruce() {
      state.truceMode = !state.truceMode;
      log(state.truceMode ? "❄️ Mode Trêve activé : le Bastion est gelé." : "🔥 Fin de la Trêve : reprise des opérations.");
      save();
    }

    function triggerSiege() {
      if (state.truceMode) return;
      const def = getTotalDefense();
      const threat = getThreat();

      if (def >= threat) {
        state.week++;
        state.reconstructionBoost = false;
        gainHeroXp(50);
        log(`🏆 VICTOIRE HÉROÏQUE (${def} contre ${threat}) ! Le siège est brisé, ton Héros gagne +50 XP !`);
      } else {
        state.week++;
        state.reconstructionBoost = true;
        if (state.buildings.remparts > 1) state.buildings.remparts--;
        log(`🛡️ REPLI STRATÉGIQUE (${def} contre ${threat}). Les murs ont souffert, mais "Effort de Reconstruction (Gains x2)" est activé !`);
      }

      state.tempDef = 0;
      state.militiaUsedThisWeek = false;
      state.militiaActiveToday = false;
      state.hero.spellUsedToday = false;
      state.dailies.forEach(t => t.done = false);
      save();
    }

    // RENDU UI
    function render() {
      const f = FACTIONS[state.faction];
      const tier = f.tiers[state.tierIndex];

      // Appliquer le thème visuel des 4 factions
      document.body.className = f.themeClass;
      document.getElementById("faction-select").value = state.faction;

      document.getElementById("ui-tier-title").textContent = `🏰 ${tier.name} — ${f.name} (Tiers ${state.tierIndex + 1})`;
      document.getElementById("ui-workers-title").textContent = `⛏️ Récolte Quotidienne (${f.workerName})`;
      document.getElementById("ui-altar-title").textContent = f.altarName;

      document.getElementById("ui-status-sub").textContent = state.truceMode
        ? `❄️ Mode Trêve Actif — Aucune pénalité`
        : state.reconstructionBoost
          ? `🔨 Effort de Reconstruction Actif (Gains doublés !)`
          : `Semaine ${state.week} • ${f.motto}`;

      document.getElementById("res-vivres").textContent = state.vivres;
      document.getElementById("res-materiaux").textContent = state.materiaux;
      document.getElementById("res-savoir").textContent = state.savoir;

      const upkeep = getUpkeepMultiplier();
      const upLabel = document.getElementById("ui-upkeep-label");
      upLabel.textContent = upkeep.label;
      upLabel.style.color = upkeep.color;
      document.getElementById("ui-upkeep-sub").textContent = upkeep.sub;

      // Boutons globaux
      document.getElementById("btn-militia").disabled = state.militiaUsedThisWeek || state.truceMode;
      document.getElementById("btn-militia").textContent = state.militiaUsedThisWeek ? "Capacité déjà utilisée (Semaine)" : f.specialBtn;
      document.getElementById("btn-truce").textContent = state.truceMode ? "🔥 Quitter la Trêve" : "❄️ Mode Trêve";

      // Liste Habitudes
      const dList = document.getElementById("daily-list");
      dList.innerHTML = "";
      const catNames = { vivres: "🍖 Ravitaillement", materiaux: "🪵 Bois", savoir: "🪙 Or & Savoir" };
      let baseGain = state.reconstructionBoost ? 30 : 15;
      if (state.militiaActiveToday) baseGain += 10;
      const gain = Math.round(baseGain * upkeep.mult);

      state.dailies.forEach(t => {
        const div = document.createElement("div");
        div.className = "task-item" + (t.done ? " done" : "");
        div.innerHTML = `
          <div class="task-left">
            <strong>${t.title}</strong>
            <span class="tag tag-${t.cat}">${catNames[t.cat]} (+${gain})</span>
          </div>
          <button onclick="completeDaily(${t.id})" ${t.done || state.truceMode ? "disabled" : ""}>${t.done ? "Fait ✓" : "Valider"}</button>
          <button class="btn-del" title="Supprimer" onclick="deleteDaily(${t.id})">✕</button>
        `;
        dList.appendChild(div);
      });

      // Liste Creeps
      const cList = document.getElementById("creep-list");
      cList.innerHTML = "";
      const diffLabels = {
        green: { text: "🟢 Camp Gnoll (+35 XP, +15 🪙)", cls: "tag-green" },
        orange: { text: "🟠 Camp Ogre (+70 XP, +30 🪙)", cls: "tag-orange" },
        red: { text: "🔴 Dragon Rouge (+120 XP, +60 🪙, Objet 100%)", cls: "tag-red" }
      };
      state.creeps.forEach(c => {
        const div = document.createElement("div");
        div.className = "task-item";
        div.innerHTML = `
          <div class="task-left">
            <strong>${c.title}</strong>
            <span class="tag ${diffLabels[c.diff].cls}">${diffLabels[c.diff].text}</span>
          </div>
          <button class="btn-gold" onclick="clearCreep(${c.id})" ${state.truceMode ? "disabled" : ""}>⚔️ Attaquer</button>
          <button class="btn-del" title="Supprimer" onclick="deleteCreep(${c.id})">✕</button>
        `;
        cList.appendChild(div);
      });

      // Menu déroulant dynamique des Héros selon la faction active
      const heroSelect = document.getElementById("hero-select");
      heroSelect.innerHTML = "";
      Object.keys(f.heroes).forEach(hKey => {
        const opt = document.createElement("option");
        opt.value = hKey;
        opt.textContent = f.heroes[hKey].label;
        heroSelect.appendChild(opt);
      });
      heroSelect.value = state.hero.type;

      const hData = f.heroes[state.hero.type];
      document.getElementById("ui-hero-name").textContent = hData.name;
      document.getElementById("ui-hero-lvl").textContent = `Niveau ${state.hero.level} (+${state.hero.level * 10} Déf)`;
      document.getElementById("ui-hero-desc").textContent = hData.desc;

      const spellBtn = document.getElementById("btn-hero-spell");
      spellBtn.textContent = state.hero.spellUsedToday ? "Sort rechargé demain" : hData.spellName;
      spellBtn.disabled = state.hero.spellUsedToday || state.truceMode;

      const neededXp = state.hero.level * 100;
      document.getElementById("ui-hero-xp").textContent = state.hero.level >= 10 ? "NIVEAU MAX (10)" : `${state.hero.xp} / ${neededXp} XP`;
      document.getElementById("ui-xp-bar").style.width = state.hero.level >= 10 ? "100%" : `${Math.min(100, (state.hero.xp / neededXp) * 100)}%`;

      const invGrid = document.getElementById("inventory-grid");
      invGrid.innerHTML = "";
      for (let i = 0; i < 6; i++) {
        const slot = document.createElement("div");
        const item = state.hero.inventory[i];
        if (item) {
          slot.className = "inv-slot filled";
          slot.textContent = `${item.name} (+${item.def})`;
        } else {
          slot.className = "inv-slot";
          slot.textContent = `Slot ${i + 1} vide`;
        }
        invGrid.appendChild(slot);
      }

      // Bâtiments & Tiers
      const tierBtn = document.getElementById("btn-upgrade-tier");
      if (state.tierIndex >= 2) {
        tierBtn.textContent = `🏰 ${tier.name} Max (Tiers 3)`;
        tierBtn.disabled = true;
      } else {
        const nextT = f.tiers[state.tierIndex + 1];
        tierBtn.textContent = `Évoluer en ${nextT.name} (${nextT.costWood} 🪵 / ${nextT.costGold} 🪙)`;
        tierBtn.disabled = state.truceMode;
      }

      const bCont = document.getElementById("buildings-container");
      bCont.innerHTML = "";
      Object.keys(f.buildings).forEach(key => {
        const b = f.buildings[key];
        const lvl = state.buildings[key];
        const card = document.createElement("div");
        card.className = "building-card";
        card.innerHTML = `
          <div>
            <strong>${b.name}</strong> (Niv. ${lvl})
            <div style="font-size:0.78rem; color:var(--muted);">Défense : +${lvl * b.def} (+${b.def}/niv)</div>
          </div>
          <button onclick="upgradeBuilding('${key}')" ${state.truceMode ? "disabled" : ""}>Améliorer (${b.cost} ${b.icon})</button>
        `;
        bCont.appendChild(card);
      });

      // Siège
      document.getElementById("ui-week").textContent = state.week;
      document.getElementById("ui-def").textContent = getTotalDefense();
      document.getElementById("ui-threat").textContent = getThreat();
      document.getElementById("ui-militia-badge").textContent = state.militiaActiveToday ? "🔥 Capacité Spéciale Active !" : "";
      document.getElementById("btn-siege").disabled = state.truceMode;
    }
function updateClock() {
      const now = new Date();
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
      const clockElement = document.getElementById("live-clock");
      if (clockElement) {
        clockElement.textContent = "🕒 " + now.toLocaleDateString('fr-FR', options);
      }
    }
    // Lancer l'horloge en direct
    setInterval(updateClock, 1000);
    updateClock();
    render();
  </script>
</body>
</html>